{
  "name": "Resume Builder",
  "dockerFile": "../docker/Dockerfile",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "remoteEnv": {
    "RESUME_IN_DOCKER": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "james-yu.latex-workshop",
        "redhat.vscode-yaml"
      ]
    }
  }
}
